[gd_resource type="Resource" script_class="SkillCatalog" load_steps=15 format=3]

[ext_resource type="Script" path="res://scripts/progression/skill_catalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://scripts/progression/skill_data.gd" id="2_skill"]

[sub_resource type="Resource" id="Skill_better_scavenging"]
script = ExtResource("2_skill")
id = &"better_scavenging"
display_name = "Better Scavenging"
description = "Find more Food during scavenging activities."
category = 0
food_cost = 5
effect_id = &"food_yield_multiplier"
effect_value = 0.1

[sub_resource type="Resource" id="Skill_full_pockets"]
script = ExtResource("2_skill")
id = &"full_pockets"
display_name = "Full Pockets"
description = "Increase how much Food can be carried."
category = 0
food_cost = 10
prerequisites = Array[StringName]([&"better_scavenging"])
effect_id = &"food_capacity"
effect_value = 5

[sub_resource type="Resource" id="Skill_food_finder"]
script = ExtResource("2_skill")
id = &"food_finder"
display_name = "Food Finder"
description = "Improve the chance of discovering Food sources."
category = 0
food_cost = 15
prerequisites = Array[StringName]([&"full_pockets"])
effect_id = &"food_discovery_bonus"
effect_value = 0.1

[sub_resource type="Resource" id="Skill_faster_flight"]
script = ExtResource("2_skill")
id = &"faster_flight"
display_name = "Faster Flight"
description = "Increase flight speed."
category = 1
food_cost = 5
effect_id = &"flight_speed_add"
effect_value = 20.0

[sub_resource type="Resource" id="Skill_stronger_flaps"]
script = ExtResource("2_skill")
id = &"stronger_flaps"
display_name = "Stronger Flaps"
description = "Increase the strength of each flap."
category = 1
food_cost = 10
prerequisites = Array[StringName]([&"faster_flight"])
effect_id = &"flap_strength_add"
effect_value = 25.0

[sub_resource type="Resource" id="Skill_energy_reserve"]
