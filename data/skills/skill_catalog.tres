[resource]
script = ExtResource("1_catalog")
skills = Array[ExtResource("2_skill")]([SubResource("Skill_better_scavenging"), SubResource("Skill_full_pockets"), SubResource("Skill_food_finder"), SubResource("Skill_faster_flight"), SubResource("Skill_stronger_flaps"), SubResource("Skill_energy_reserve"), SubResource("Skill_dive"), SubResource("Skill_peck"), SubResource("Skill_rush_hour"), SubResource("Skill_double_crumbs"), SubResource("Skill_first_recruit"), SubResource("Skill_larger_flock"), SubResource("Skill_bread_spawns"), SubResource("Skill_bread_value")])
