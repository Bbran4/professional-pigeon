[ext_resource type="Script" path="res://scripts/state_machine/states/walk_state.gd" id="5_walk"]
[ext_resource type="Script" path="res://scripts/pigeon/pigeon_stats.gd" id="6_stats"]

[sub_resource type="CapsuleShape2D" id="CapsuleShape2D_player"]

[sub_resource type="Resource" id="PigeonStats_player"]
script = ExtResource("6_stats")
resource_local_to_scene = true
walk_speed = 100.0
flight_speed = 200.0
max_energy = 100.0
energy_regeneration = 10.0
