layout_mode = 2
min_value = 0.0
max_value = 1.0
step = 0.05
value = 1.0

[node name="Fullscreen" type="CheckBox" parent="Content"]
layout_mode = 2
text = "Fullscreen"

[node name="VSync" type="CheckBox" parent="Content"]
layout_mode = 2
text = "Vertical sync"
